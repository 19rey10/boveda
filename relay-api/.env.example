# Copiar este archivo a ".env" y completar - el .env real NUNCA se commitea

DATABASE_URL=sqlite:///./boveda_relay.db

# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambiar_esto_por_algo_random_de_64_caracteres

# Secreto compartido entre el relay y worker-local (tu laptop).
# Generar igual que el JWT_SECRET, uno distinto.
WORKER_SECRET=cambiar_esto_tambien

# SMTP para recuperacion de contraseña por email (ej: Gmail con
# contraseña de aplicacion, o un servicio como Resend/SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM=tu_correo@gmail.com

APP_URL=https://tuapp.ejemplo.com
