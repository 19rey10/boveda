# Copiar a ".env" en la laptop - NUNCA commitear el .env real

# Hostname o URL publica del relay. Si lo desplegaste en Render/Fly/Railway,
# es la URL que te dan directo (ej: https://boveda-relay.onrender.com).
# Ya no hace falta Tailscale para esto - el relay es publico.
RELAY_URL=https://boveda-relay.onrender.com

# Debe ser IDENTICO al WORKER_SECRET del .env del relay
WORKER_SECRET=cambiar_esto_tambien

# Donde esta montada tu SSD Toshiba en la laptop
RUTA_SSD=/mnt/ssd_boveda

INTERVALO_POLLING=30
